---
import Base from '../layouts/Base.astro';
import { waLink } from '../lib/site.js';
---
<Base title="Page not found" noindex>
  <div class="container section" style="text-align:center">
    <h1>We couldn't find that page</h1>
    <p class="muted">Try searching for your medicine, or ask an agent.</p>
    <div class="row" style="justify-content:center"><a class="btn btn-primary" href="/products/">Browse medicines</a><a class="btn btn-wa" href={waLink('Hello, I need help finding a medicine.')} target="_blank" rel="noopener">WhatsApp an agent</a></div>
  </div>
</Base>
