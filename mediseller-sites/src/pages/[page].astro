---
// Renders per-site Markdown pages from sites/<SITE>/content/*.md (about, privacy, terms, disclaimer…)
import Base from '../layouts/Base.astro';
export async function getStaticPaths() {
  const pages = import.meta.glob('@site/content/*.md', { eager: true });
  return Object.entries(pages).map(([path, mod]) => ({
    params: { page: path.split('/').pop().replace(/\.md$/, '') },
    props: { mod },
  }));
}
const { mod } = Astro.props;
const { Content, frontmatter } = mod;
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="container section prose">
    <h1>{frontmatter.title}</h1>
    <Content />
  </article>
</Base>
