---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import { products, categories } from '../../lib/catalogue.js';
import site from '../../lib/site.js';
export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}
const { category } = Astro.props;
const items = products.filter((p) => p.category === category.name);
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${site.domain}/` },
  { '@type': 'ListItem', position: 2, name: category.name, item: `https://${site.domain}${category.url}` } ] };
---
<Base title={`${category.name} medicines from India`} description={`${category.name}: ${items.slice(0, 6).map((p) => p.generic).join(', ')} and more. Sourced from India and shipped worldwide — request the best price from an agent.`} schema={[crumbs]}>
  <div class="container" style="padding-top:24px;padding-bottom:56px">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/products/">Medicines</a> / {category.name}</nav>
    <h1 style="margin-top:12px">{category.name}</h1>
    <p class="muted">{items.length} medicines listed. Your agent confirms price, availability and shipping for your country.</p>
    <Listing items={items} activeCategory={category.slug} />
  </div>
</Base>
